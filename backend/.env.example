# MongoDB connection string (Atlas or self-hosted).
# ⚠️ Rotate your Atlas password before reusing this project — the previous
# .env had a live username/password committed into a shared zip file.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?appName=Cluster0

# Secret used to sign participant JWTs — use a long random string
# (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_secret

# Shared secret admins send in the X-Admin-Key header to access /api/admin/*
ADMIN_API_KEY=replace_with_a_long_random_secret

# Port the server listens on
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
# e.g. https://akwaba001.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Paystack secret key (from your Paystack dashboard — starts with sk_)
PAYSTACK_SECRET_KEY=sk_test_replace_me

# URL Paystack redirects to after checkout — must be a route on your
# deployed FRONTEND (e.g. https://akwaba001.vercel.app/dashboard)
PAYMENT_CALLBACK_URL=

# Total trip cost per participant, in Naira (plain number, no commas)
TRIP_TOTAL_AMOUNT_NGN=

# Minimum first payment a participant must make before any deposit has
# landed, in Naira (plain number, no commas). Optional — defaults to 100000
# (capped at TRIP_TOTAL_AMOUNT_NGN) if unset. See utils/utils_payments.js.
MIN_INITIAL_DEPOSIT_NGN=100000

NODE_ENV=development
