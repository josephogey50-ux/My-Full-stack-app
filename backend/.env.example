# MongoDB connection string (Atlas or self-hosted).
# ⚠️ Rotate your Atlas password before reusing this project — the previous
# .env had a live username/password committed into a shared zip file.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?appName=Cluster0

# Secret used to sign participant JWTs — use a long random string
# (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_secret

# Shared secret organizers exchange (once, via POST /api/admin/login, along
# with a display name) for a short-lived httpOnly admin session cookie —
# not sent as a header on every request. See middleware/auth.js.
ADMIN_API_KEY=replace_with_a_long_random_secret

# Port the server listens on
PORT=5000

# Comma-separated list of allowed frontend origins for CORS. Production
# runs the frontend as a Render Static Site behind the custom domain below
# (Cloudflare-proxied DNS, not Vercel) — include both the apex and www host.
# e.g. https://nigerianpassporttravels.com,https://www.nigerianpassporttravels.com,http://localhost:5173
ALLOWED_ORIGINS=

# Paystack secret key (from your Paystack dashboard — starts with sk_)
PAYSTACK_SECRET_KEY=sk_test_replace_me

# URL Paystack redirects to after checkout — must be a route on your
# deployed FRONTEND (e.g. https://www.nigerianpassporttravels.com/dashboard)
PAYMENT_CALLBACK_URL=

# Trip cost for a solo traveler (room "matched" with a same-sex roommate),
# in Naira per participant (plain number, no commas)
SINGLE_TRIP_TOTAL_AMOUNT_NGN=

# Trip cost for a traveler in a "paired" couple, in Naira PER PERSON (plain
# number, no commas) — each partner still registers and pays as their own
# account, each at this rate. See utils/utils_payments.js.
COUPLE_TRIP_TOTAL_AMOUNT_NGN=

# Minimum first payment a single-tier participant must make before any
# deposit has landed, in Naira (plain number, no commas). Optional — defaults
# to 150000 (capped at the participant's own trip total) if unset.
# See utils/utils_payments.js.
SINGLE_MIN_INITIAL_DEPOSIT_NGN=150000

# Same, for a "paired" (couple) participant. Optional — defaults to 200000
# (capped at the participant's own trip total) if unset.
COUPLE_MIN_INITIAL_DEPOSIT_NGN=200000

NODE_ENV=development

# Gmail account used to send "forgot PIN" reset emails via SMTP (nodemailer).
# GMAIL_APP_PASSWORD is a 16-character app password from
# myaccount.google.com/apppasswords — NOT your regular Gmail password (that
# won't work; Google blocks plain-password SMTP login for security).
# If unset, the forgot-PIN feature fails (logged server-side) but the rest
# of the app still runs normally.
GMAIL_USER=
GMAIL_APP_PASSWORD=
